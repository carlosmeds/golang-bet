# .env.example
# Database
DATABASE_URL=postgres://wagering:wagering_password@localhost:54320/wagering?sslmode=disable

# SQS
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
# The broker only accepts provisioned IAM identities (see README "Broker access"):
# run infra/localstack/export-broker-credentials.sh and use the wagering-app profile.
AWS_SHARED_CREDENTIALS_FILE=./tmp/broker-credentials
AWS_PROFILE=wagering-app
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
EVENT_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# OIDC Identity Provider (Keycloak)
OIDC_ISSUER_URL=http://localhost:8082/realms/wagering
OIDC_AUDIENCE=wagering-api

# Application HTTP Server
HTTP_ADDR=:8081
SHUTDOWN_TIMEOUT=15s
